# ============================================================
# SentinelCore — Environment Variables
# Copy to .env and fill in all REQUIRED values before starting
# ============================================================

# --- REQUIRED: Security Keys ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDS_MASTER_KEY=
FACE_ENCRYPTION_KEY=

# --- REQUIRED: Redis ---
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# --- REQUIRED: MinIO (Production) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# --- REQUIRED: PostgreSQL ---
DB_PASSWORD=
DATABASE_URL=postgresql://sentinel:${DB_PASSWORD}@postgres:5432/sentinel

# --- REQUIRED: JWT ---
JWT_SECRET=

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:1.7b
VLM_MODEL=qwen2.5vl:3b

# --- CORS (dashboard origin) ---
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# --- Tenant (auto-provisioned on first start) ---
# DEFAULT_TENANT_ID=

# --- Storage ---
# "local" for dev, "minio" for production
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/storage
