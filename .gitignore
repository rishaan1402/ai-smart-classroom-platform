# Root .gitignore (repo-wide)

# --- Secrets / env files ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual envs
.venv/
venv/
env/
ENV/

# --- Caches / test artifacts ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
*.cache

# --- Jupyter ---
.ipynb_checkpoints/

# --- Logs / runtime artifacts ---
*.log
logs/
data/logs/
sentinel_core/data/logs/

# --- Local storage / outputs ---
data/output/
data/storage/
sentinel_core/data/output/
sentinel_core/data/storage/

# --- Model weights / large binaries (download locally) ---
models/
sentinel_core/models/
*.pt
*.onnx
*.mlx

# --- Node / frontend ---
node_modules/
dashboard/node_modules/
dist
dist-ssr
*.local

# --- IDE / OS ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~


# --- Classroom data: children's personal data, never commit ---
footage/
roster/
consent/
labels/
data/
*.mp4
*.mov
*.avi
*.mkv
*.dav
*.wav
*.npy
*.faiss
*.key
*.db
outputs/
